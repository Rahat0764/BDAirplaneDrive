    "preview": "node ./node_modules/vite/bin/vite.js preview --host"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "rollup": "npm:@rollup/wasm-node@^4.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.24.0"
  }
}
