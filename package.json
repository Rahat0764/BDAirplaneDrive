{
  "name": "dream-flight",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "DREAM FLIGHT — A Peaceful, Photorealistic & Ghibli-Sunlit 3D Airplane Experience",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
